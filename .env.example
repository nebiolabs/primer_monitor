AIRBRAKE_HOST=http://localhost:5000
AIRBRAKE_PROJECT_ID=1
AIRBRAKE_PROJECT_KEY=example
IGV_DATA_SERVER=http://localhost:8080
DB_USER_RO=primer_monitor_ro
DB_USER=primer_monitor
DB_HOST=localhost:5432
DB_NAME=primer_monitor_dev
FRONTEND_HOST="user@frontend-host"
JUMP_PROXY="user@proxy-host"
IGVSTATIC_PATH="/path/to/igvstatic"
BACKEND_SCRATCH_PATH="/path/to/backend/scratch"
NEXTFLOW_INSTALL_PATH="/path/to/nextflow"
MICROMAMBA_BIN_PATH="/path/to/micromamba/bin"
PIXI_BIN_PATH="/path/to/pixi/bin"
CONDA_BIN_PATH="/path/to/conda/bin"
BACKEND_INSTALL_PATH="/path/to/backend/install"
NOTIFICATION_EMAILS="someuser@example.com,anotheruser@example.com"
PCT_CUTOFF=1
SCORE_CUTOFF=3
NXF_JAVA_HOME=/path/to/JAVA_HOME/for/nextflow
PSQL_INSTALL_PATH="/path/to/psql"
LOCK_PATH="/var/lock"
TEMP_DIR="/tmp"
ADMIN_EMAIL="admin-user@example.com"
ENV_NAME="production"
FRONTEND_LOG_PATH="/path/to/frontend/logs"
DEPLOY_SHARED_DIR="/path/to/deploy/shared/dir"
# Entra ID (Azure) app registration for NEB staff sign-in. The client secret normally comes from
# credentials (entra_client_secret); the Microsoft button only appears when a secret is available.
# Client and tenant ids default to the NEB registration; override here only to use a different one.
# Register https://<host>/users/auth/entra_id/callback as a redirect URI on the app registration.
# ENTRA_CLIENT_SECRET=<client-secret>
# ENTRA_CLIENT_ID=ca0491f6-fdd5-4ce0-8a20-627c4651fc7b
# ENTRA_TENANT_ID=77cefbc6-b3d6-4d6a-9f74-0664881c384b
# Optional: defaults to the callback URL of the request host
# ENTRA_REDIRECT_URI=https://primer-monitor.neb.com/users/auth/entra_id/callback
