<%# positions are computed by aligning the sequence (PrimerSet#align_primers), not entered by hand %>
<% if oligo.oligo_alignment_positions.any? %>
  <ul>
    <% oligo.oligo_alignment_positions.each do |pos| %>
      <li><%= pos.organism_taxon.name %> (<%= pos.organism_taxon.reference_accession %>): <%= pos.ref_start %> - <%= pos.ref_end %></li>
    <% end %>
  </ul>
<% else %>
  <em>not aligned yet</em>
<% end %>
