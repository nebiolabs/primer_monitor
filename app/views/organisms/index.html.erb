
<h1>Organisms</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Ncbi taxa</th>
    </tr>
  </thead>

  <tbody>
    <% @organisms.each do |organism| %>
      <tr>
        <td><%= link_to organism.name, organism_path(organism) %></td>
        <td>
          <ul>
            <% organism.organism_taxa.each do |taxon| %>
              <li><%= link_to taxon.name, taxon.url  %></li>
            <% end %>
          </ul>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Organism', new_organism_path %>
