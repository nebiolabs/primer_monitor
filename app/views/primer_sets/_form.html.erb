<% content_for :head do %>
  <%= javascript_import_module_tag "oligo_editor" %>
<% end %>

<%= form_with(model: primer_set, local: true) do |form| %>
    <% if primer_set.errors.any? %>
    <div class="notification is-warning">
      <h2><%= pluralize(primer_set.errors.count, "error") %> prohibited this primer set from being saved:</h2>
      <ul>
        <% primer_set.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field is-horizontal">
    <div class="field-label">
      <%= form.label :name %>
    </div>
    <div class="control field-body">
      <%= form.text_field :name %>
    </div>
  </div>

  <div class="field is-horizontal">
    <div class="field-label">
      <%= form.label 'Amplification method' %>
    </div>
    <div class="control field-body">
      <%= form.collection_select :amplification_method_id, AmplificationMethod.all, :id, :name, prompt: true  %>
    </div>
  </div>

  <div class="field is-horizontal">
    <div class="field-label">
      <%= form.label 'Sources' %>
    </div>
    <div class="control field-body">
      <%= form.text_field :citation_url,maxlength: 255, size: 30, placeholder: 'URL' %>
      <%= form.text_field :doi, maxlength: 255, size: 30, placeholder: 'doi'%>
    </div>
  </div>

  <% if can? :confirm, PrimerSet %>
    <div class="field is-horizontal">
      <div class="field-label">
        <%= form.label :status %>
      </div>
      <div class="control field-body">
        <%= form.select :status, PrimerSet.statuses.keys %>
      </div>
    </div>
  <% end %>

  <div class="field is-horizontal">
    <div class="field-label">
      <%= form.label :organism %>
    </div>
    <div class="control field-body">
      <%= form.select :organism_id, options_from_collection_for_select(Organism.all, :id, :name)  %>
      <% if can? :create, Organism %>
        <%= link_to new_organism_path do %>
          <%= image_tag("add_icon.svg", alt: 'add organism',class: 'icon')%>
        <% end %>
      <% end %>
    </div>
  </div>

  <section class="oligo-editor block" data-oligo-editor>
    <h4 class="subtitle is-4">Oligos <span class="tag is-light" data-oligo-summary></span></h4>

    <div class="oligo-toolbar">
      <div class="field has-addons">
        <div class="control">
          <input type="search" class="input is-small" placeholder="Filter oligos" aria-label="Filter oligos"
                 data-oligo-filter>
        </div>
      </div>
      <div class="field has-addons" title="Applies to the checked rows">
        <div class="control"><span class="button is-small is-static" data-oligo-selected-count>0 selected</span></div>
        <div class="control">
          <div class="select is-small">
            <select aria-label="Category for checked rows" data-bulk-category>
              <option value="">category: auto</option>
              <% Oligo.categories.each_key do |category| %>
                <option value="<%= category %>"><%= category %></option>
              <% end %>
            </select>
          </div>
        </div>
        <div class="control">
          <button type="button" class="button is-small" data-bulk-action="category">Set category</button>
        </div>
        <div class="control">
          <input type="text" class="input is-small locus-input" placeholder="locus" aria-label="Locus for checked rows"
                 data-bulk-locus>
        </div>
        <div class="control">
          <button type="button" class="button is-small" data-bulk-action="locus">Set locus</button>
        </div>
        <div class="control">
          <button type="button" class="button is-small" data-bulk-action="short_name"
                  title="Clear the short names so they are derived from the oligo names on save">Auto short names</button>
        </div>
        <div class="control">
          <button type="button" class="button is-small is-danger is-outlined" data-bulk-action="remove">Remove</button>
        </div>
      </div>
    </div>
    <p class="help mb-2">
      Click a column heading to sort. Paste several lines from a spreadsheet into a cell to fill the rows below it;
      tab-separated columns fill the cells to the right. Blank short name, locus and category are derived from the
      oligo name when saved.
    </p>

    <div class="oligo-table-wrap">
      <table class="table is-narrow is-fullwidth oligo-table" data-datatable="off">
        <thead>
          <tr>
            <th><input type="checkbox" aria-label="Select all shown oligos" data-select-all></th>
            <th data-sort-key="name">Name</th>
            <th data-sort-key="short_name">Short name</th>
            <th data-sort-key="locus">Locus</th>
            <th data-sort-key="category">Category</th>
            <th data-sort-key="sequence">Sequence</th>
            <th data-sort-key="length" class="has-text-right">Length</th>
            <th><span class="is-sr-only">Remove</span></th>
          </tr>
        </thead>
        <tbody id="samples" data-nested-fields>
          <%= form.fields_for :oligos, include_id: false do |es| %>
            <%= render 'oligo_fields', f: es %>
          <% end %>
          <template data-nested-template>
            <%= form.fields_for :oligos, Oligo.new, child_index: 'NEW_RECORD', include_id: false do |es| %>
              <%= render 'oligo_fields', f: es %>
            <% end %>
          </template>
        </tbody>
      </table>
    </div>

    <div class="buttons mt-3">
      <button type="button" class="button" data-nested-add="#samples">Add Oligo</button>
      <div class="file" id="fasta_div">
        <label class="file-label" id="fasta_upload_label">
          <input class="file-input" type="file" name="fasta" id="fasta_upload" accept=".fa,.fasta,.fna,.txt">
          <span class="file-cta white-button">
            <span class="file-label">Upload FASTA...</span>
          </span>
        </label>
      </div>
    </div>
    <p class="help">Uploaded sequences replace the sequence of an oligo with the same name and add the rest as new rows.</p>
  </section>

  <div class="actions">
    Note: after processing, submitted primer sets will appear on the public primer sets page.
    <br>
    <%= form.submit class: 'button is-link'%>
  </div>
<% end %>