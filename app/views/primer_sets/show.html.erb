<% content_for :head do %>
  <%= javascript_import_module_tag "primer_sets_show" %>
<% end %>

<h1 class="title">Primer Set: <%= @primer_set.name %> </h1>
<div class="columns is-multiline">
  <div class="column is-narrow">
    <div class="box">
    <strong>Organism: </strong>
    <%= link_to @primer_set.organism, @primer_set.organism %>
    </div>
  </div>
  <div class="column is-narrow">
    <div class="box">
    <strong>Amp. Method: </strong>
    <%= link_to @primer_set.amplification_method.to_s, @primer_set.amplification_method.description_url %>
    </div>
  </div>
  <% if @primer_set.display_url %>
    <div class="column is-narrow">
      <div class="box">
      <strong> Source: </strong>
          <%= external_link @primer_set.display_url, @primer_set.display_url %>
      </div>
    </div>
  <% end %>
  <% if can?(:confirm, PrimerSet) %>
    <div class="column is-narrow">
      <div class="box">
      <strong>Status: </strong>
      <%= @primer_set.status %>
      </div>
    </div>
  <% end %>
  <div class="column is-narrow">
    <div class="box">
    <strong>FASTA: </strong>
    <% if @config.key?('primer_set_name') %>
      <a href="<%= "#{@config[:data_server]}/#{@config[:organism_slug]}/primer_sets_fasta/#{@config['primer_set_name']}.fasta" %>">Download FASTA</a>
    <% else %>
      Pending
    <% end %>
    </div>
  </div>
  <div class="column is-narrow">
    <div class="box">
    <strong>BED: </strong>
    <% if @config.key?('primer_set_name') %>
      <a href="<%= "#{@config[:data_server]}/#{@config[:organism_slug]}/primer_sets_bed/#{@config['primer_set_name']}.bed" %>">Download BED</a>
    <% else %>
      Pending
    <% end %>
    </div>
  </div>
  <% if can?(:edit, @primer_set.user) %>
    <div class="column is-narrow">
      <div class="box">
        <strong>Creator: </strong>
        <%= @primer_set.user %>
      </div>
    </div>
  <% end %>


  <div class="column is-narrow">
    <div>
    <%= render 'primer_set_subscription',
               user: current_user,
               primer_set: @primer_set,
               primer_set_subscription: @primer_set.subscription_for_user(current_user) %>
    </div>
  </div>
</div>

<% if current_user %>
  <%= render 'your_subscription', user: current_user, primer_set: @primer_set %>
<% end %>

<hr/>

<p id="config" class="invisible" data-igv-page="primer_set"><%= @config.to_json %></p>

<% if @primer_set.complete? && @config.key?('primer_set_name') %>

<% if @sorted_lineages %>
<div class="block">
  <p>Variants seen recently in the selected lineage are shown in gray below the genome. Primers that overlap enough
  sufficiently-frequent variants to be potentially impacted are shown in orange, others in blue.
  See <%= link_to 'Primer Status', organism_lineage_variants_path(@primer_set.organism) %> for how impact is scored.</p>
</div>
<form id="primer_set_lineage_selection">
  <div class="field">
    <label class="label" for="primer_set_lineage_select">Lineage:</label>
    <div class="control">
      <select id="primer_set_lineage_select" name="lineage" class="searchable-select is-wide">
        <%= render 'lineage_variants/lineage_options', sorted_lineages: @sorted_lineages,
                   lineage_frequencies: @lineage_frequencies, lineage_sets: @lineage_sets,
                   selected: @config[:initial_lineage] %>
      </select>
    </div>
  </div>
</form>
<% end %>

<div id="igv" class="igv_div"></div>

<% if @sorted_lineages %>
<div id="variant_table_section" class="block" style="display:none">
  <h2 class="title is-5" id="variant_table_heading">Variants Overlapping This Primer Set</h2>
  <div id="variant_table_loading" class="has-text-centered" style="display:none; padding: 1rem;">
    <progress class="progress is-primary" style="max-width: 16rem; margin: 0 auto;" max="100"></progress>
  </div>
  <div id="variant_table_content"></div>
</div>
<% end %>

<% else %>

<p class="igv-message">
  The genome view of this primer set will appear once it has been approved and processed.
</p>

<% end %>

<hr/>

<h2 class="title">Primers:</h2>
<table>
  <thead>
  <tr>
    <th data-priority="1">Name</th>
    <th>Locus</th>
    <th>Category</th>
    <th data-priority="2">Sequence</th>
  </tr>
  </thead>

  <tbody>
  <% @primer_set.oligos.each do |oligo| %>
    <tr>
      <td><%= link_to_if can?(:edit, oligo), oligo.name, edit_oligo_path(oligo) %></td>
      <td><%= oligo.locus %></td>
      <td><%= oligo.category %></td>
      <td><%= oligo.sequence %></td>
    </tr>
  <% end %>
  </tbody>
</table>


<% if can? :edit, @primer_set %>
  <%= link_to 'Edit', edit_primer_set_path(@primer_set) %> |
<% end %>
<%= link_to 'All Primer Sets', organism_primer_sets_path(@primer_set.organism.slug) %>