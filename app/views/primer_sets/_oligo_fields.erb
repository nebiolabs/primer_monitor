<% oligo = f.object %>
<%# a failed save re-renders removed rows still marked for destruction %>
<tr class="<%= class_names('nested-fields', 'is-invalid': oligo.errors.any?, 'is-removed': oligo.marked_for_destruction?) %>"
    data-persisted="<%= oligo.persisted? %>">
  <td><input type="checkbox" aria-label="Select oligo" data-oligo-select></td>
  <td>
    <%= f.hidden_field :id if oligo.persisted? %>
    <%= f.text_field :name, class: 'input is-small', placeholder: 'Oligo name', data: { col: 'name' } %>
    <% if oligo.errors.any? %>
      <p class="help is-danger"><%= oligo.errors.full_messages.to_sentence %></p>
    <% end %>
  </td>
  <td>
    <%= f.text_field :short_name, class: 'input is-small', placeholder: 'auto', maxlength: 5,
                                  data: { col: 'short_name' } %>
  </td>
  <td><%= f.text_field :locus, class: 'input is-small', placeholder: 'auto', data: { col: 'locus' } %></td>
  <td>
    <div class="select is-small is-fullwidth">
      <%= f.select :category, Oligo.categories.keys, { include_blank: 'auto' }, data: { col: 'category' } %>
    </div>
  </td>
  <td>
    <%= f.text_field :sequence, class: 'input is-small oligo-sequence', placeholder: 'DNA sequence (ACGT)',
                                spellcheck: false, autocomplete: 'off', data: { col: 'sequence' } %>
  </td>
  <td class="has-text-right" data-oligo-length></td>
  <td>
    <%= f.hidden_field :_destroy %>
    <button type="button" class="delete" data-nested-remove title="Remove" aria-label="Remove oligo"></button>
  </td>
</tr>
