<h1 class="title">Notification email</h1>

<p><strong>User:</strong> <%= link_to @notification.user, @notification.user %> (<%= @notification.user.email %>)<%= ', inactive' unless @notification.user.active? %></p>
<p><strong>Status:</strong> <%= @notification.status %></p>
<p><strong>When:</strong> <%= l(@notification.updated_at, format: :long) %></p>

<h2 class="title is-5"><%= pluralize(@alerts.size, 'alert') %></h2>
<div class="table-container">
  <table class="table is-striped is-narrow is-hoverable">
    <thead>
      <tr>
        <th>Primer set</th><th>Locus</th><th>Primer</th><th>Geographic region</th><th class="has-text-right">Frequency</th>
      </tr>
    </thead>
    <tbody>
      <% @alerts.each do |alert| %>
        <tr>
          <td><%= link_to alert.primer_set, alert.primer_set %></td>
          <td><%= alert.oligo&.locus %></td>
          <td><%= alert.oligo&.category %></td>
          <td><%= alert.detailed_geo_location_alias %></td>
          <td class="has-text-right"><%= alert.fraction_variant.round(2) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to 'Back to notifications', notifications_path %>
