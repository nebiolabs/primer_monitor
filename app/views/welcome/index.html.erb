<article class="message is-small">
  <div class="message-header">
    <p>Welcome!</p>
  </div>
  <div class="message-body">
    This system continually monitors registered primer sets for overlapping variants in sequences from
    <a href="https://www.ncbi.nlm.nih.gov/genbank/">NCBI GenBank®</a>.
    <%= link_to "Log in", new_user_session_path %> to propose new primer sets and subscribe for notifications.
  </div>
</article>

<h1 class="title is-4 is-spaced">Organisms Overview</h1>

<hr>
<div class="columns">

  <% Organism.where(public: true).each_with_index do |organism,i| %>
      <% if i%3 == 0 # start a new row every 3 %>
        </div>
        <hr>
        <div class="columns">
      <% end %>
      <div class="column">
        <h1 class="subtitle"><%= organism.name %></h1>
        <aside class="menu">
          <p class="menu-label">
            Tools
          </p>
          <ul class="menu-list">
            <li><%= link_to organism_lineage_variants_url(organism.slug), class: 'button is-primary is-fullwidth mb-2' do %>Primer Status <% end %></li>
            <li><a href="<%= organism_primer_sets_url(organism.slug) %>">Primer Sets (<%=PrimerSet.where(organism_id: organism.id).count %>)</a></li>
            <li><a href="<%= organism_lineages_url(organism.slug) %>">Lineages (<%=Lineage.where(organism_id: organism.id).count %>)</a></li>
          </ul>
        </aside>
      </div>
  <% end %>
</div>


