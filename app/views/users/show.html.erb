
<p>
  <strong>First:</strong>
  <%= @user.first %>
</p>

<p>
  <strong>Last:</strong>
  <%= @user.last %>
</p>

<p>
  <strong>Email:</strong>
  <%= @user.email %>
</p>

<p>
  <strong>Send Primer Updates?:</strong>
  <%= @user.send_primer_updates %>
</p>

<h2 class="title">Subscriptions</h2>
<p>Locations: <%= @user.subscribed_geo_locations.includes(:detailed_geo_location_alias).map(&:to_s).join(', ').presence || 'none' %>;
  alert threshold <%= number_to_percentage(@user.variant_fraction_threshold * 100, precision: 0) %>
  over the last <%= pluralize(@user.lookback_days, 'day') %></p>
<%= render 'users/subscriptions', user: @user, unsubscribe: false %>

<% if @user == current_user %>
  <%= link_to "Edit", edit_user_registration_path %>
<% end %>
