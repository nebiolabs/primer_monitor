<h2 class='title'>User Details</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "users/shared/error_messages", resource: resource %>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div class="notification is-warning">
      Currently awaiting confirmation for: <%= resource.unconfirmed_email %><br/>
      <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name) %>
    </div>
  <% end %>

  <div class="field is-horizontal">
    <div class="field-label">
      <%= f.label 'Name' %>
    </div>
    <div class="control field-body">
      <%= f.text_field :first, placeholder: "First"%>
      <%= f.text_field :last, placeholder: "Last", size: 30 %>
    </div>
  </div>

  <div class="field is-horizontal">
    <div class="field-label">
      <%= f.label :email %>
    </div>
    <div class="control field-body">
      <%= f.email_field :email, autofocus: true, autocomplete: 'email', size: 30 %>
    </div>
  </div>

  <div class="field is-horizontal">
    <div class="field-label">
      <%= f.label :password %>
    </div>
    <div class="control field-body">
      <%= f.password_field :password, placeholder: 'New password', autocomplete: 'new-password' %>
      <%= f.password_field  :password_confirmation, placeholder: 'Confirmation', autocomplete: 'new-password' %>
      <i>(leave blank if you don't want to change it)</i>
    </div>
  </div>

  <div class="field is-horizontal">
    <div class="field-label">
      <%= f.label :current_password %>
    </div>
    <div class="control field-body">
      <%= f.password_field :current_password, placeholder: 'Current password', autocomplete: 'current-password' %>
      <i>(required to change password)</i>
    </div>
  </div>

  <div class="actions">
    <%= f.submit "Update User Details", class: 'button is-link' %>
  </div>
<% end %>
<hr/>

<h2 class="title">Sign-in methods</h2>
<div class="field is-horizontal">
  <div class="field-label">Linked account</div>
  <div class="field-body">
    <% if resource.sign_in_provider_name %>
      <span>
        <%= resource.sign_in_provider_name %> (<%= resource.email %>)
        <span class="is-size-7">— linked to this account when you last signed in with it</span>
      </span>
    <% else %>
      <span>None. You can also sign in with Google, or with Microsoft if you are NEB staff, using this email address.</span>
    <% end %>
  </div>
</div>
<div class="field is-horizontal">
  <div class="field-label">Password</div>
  <div class="field-body">
    <span>
      <%= button_to 'Email me a password reset link', user_password_reset_path, class: 'button is-small is-light',
                    form: { style: 'display: inline' } %>
      <span class="is-size-7">Sets a password for signing in with your email address; useful if you signed up with Google or Microsoft.</span>
    </span>
  </div>
</div>
<hr/>

<h2 class="title">Subscriptions</h2>

<%= render 'users/subscriptions', user: resource, unsubscribe: true %>
<p class="mb-5">
  Subscribe to more primer sets:
  <%= safe_join(Organism.where(public: true).order(:name).map { |organism| link_to "#{organism.name} primer sets", organism_primer_sets_path(organism) }, ' · ') %>
</p>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: 'subscription_form', method: :put }) do |f| %>

  <div class="field is-horizontal">
    <div class="field-label">
      Email variant updates
    </div>
    <div class="control field-body">
      <%= f.check_box :send_primer_updates %>
    </div>
  </div>

  <div class="field is-horizontal">
    <div class="field-label">
      Subscribed locations
      <span class="tag">(including all more-specific locations)</span>
    </div>
    <div class="control field-body">
      <%=f.select :subscribed_detailed_geo_location_alias_ids,
                  options_for_select(DetailedGeoLocationAlias.subscribable_options,
                                     current_user.subscribed_detailed_geo_location_alias_ids),
                  {include_blank: true} ,
                  class: 'searchable-select', style: 'width: 500px;', multiple: true
      %>
    </div>
  </div>

  <div class="field is-horizontal">
    <div class="field-label">
      Notify about variants observed within the last...
    </div>
    <div class="control field-body">
      <%= f.select :lookback_days, { '1 week': 7, '1 month': 30, '3 months': 90, 'all time': 50000 },
                   { prompt: 'Time period' },
                   { required: true, style: 'width: 120px'}%>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-label">
      Notify about variants that rise above this fraction
    </div>
    <div class="control field-body">
      <%= f.number_field :variant_fraction_threshold, in: 0..1, step: 0.01, title: '(num_variants/sequences_in_geo_location)'%>
    </div>
  </div>
  <div class="actions">
    <%= f.submit "Save Subscription Changes", class: 'button is-link' %>
  </div>
<% end %>

<%= link_to "Back", :back %>
